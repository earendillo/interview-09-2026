{
  "name": "@interview/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "platform": "node",
          "format": [
            "esm"
          ],
          "bundle": true,
          "outputPath": "apps/api/dist",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.build.json",
          "assets": [],
          "generatePackageJson": false
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@interview/api:build"
        }
      },
      "format-check": {}
    }
  },
  "devDependencies": {
    "@interview/auth": "workspace:*",
    "@interview/shared": "workspace:*"
  }
}
